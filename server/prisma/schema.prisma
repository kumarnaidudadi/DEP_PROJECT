generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model roles {
  id               Int             @id @default(autoincrement())
  name             String             @unique
  hierarchy_level  Int?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  description      String?
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model user_roles {
  id         Int    @id @default(autoincrement())
  user_id    Int?
  role_id    Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  roles      roles?    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id])
}

model users {
  id                  Int                @id @default(autoincrement())
  email               String                @unique
  password            String
  department_id       Int?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  auth_provider       String?
  emp_code            String?
  first_name          String?
  is_active           Boolean?              @default(true)
  joining_date        DateTime?
  last_name           String?
  middle_name         String?
  otp_code            String?
  otp_expiry          DateTime?
  signature_url       String?
  applied_forms       applied_forms[]
  department_heads    department_heads[]
  form_approvals      form_approvals[]
  forwards_sent       form_forwards[]       @relation("ForwardFrom")
  forwards_received   form_forwards[]       @relation("ForwardTo")
  form_history        form_history[]
  form_status_history form_status_history[]
  form_types          form_types[]
  forms               forms[]
  office_orders       office_orders[]
  user_roles          user_roles[]
}

model department_heads {
  id            Int       @id @default(autoincrement())
  department_id Int?
  user_id       Int?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([department_id, user_id])
}

model departments {
  id               Int             @id @default(autoincrement())
  name             String             @unique
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  department_heads department_heads[]
}

model form_types {
  id             Int          @id @default(autoincrement())
  name           String          @unique
  description    String?
  schema         Json            @default("{}") @map("schema_definition")
  created_by     Int?
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  approval_rules Json?           @default("{}")
  is_active      Boolean         @default(true)
  applied_forms  applied_forms[]
  users          users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forms          forms[]
  workflows      workflows[]
}

model office_orders {
  id              Int         @id @default(autoincrement())
  applied_form_id Int?
  order_number    String?
  generated_by    Int?
  generated_at    DateTime?      @default(now()) @db.Timestamp(6)
  document_url    String?
  applied_forms   applied_forms? @relation(fields: [applied_form_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model applied_forms {
  id                     Int          @id @default(autoincrement())
  form_type_id           Int?
  applicant_id           Int?
  form_data              Json
  status                 String?         @default("pending")
  current_approval_level Int?            @default(1)
  submitted_at           DateTime?       @default(now()) @db.Timestamp(6)
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  users                  users?          @relation(fields: [applicant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_types             form_types?     @relation(fields: [form_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_forwards          form_forwards[]
  form_history           form_history[]
  office_orders          office_orders[]
}

model form_history {
  id              Int         @id @default(autoincrement())
  applied_form_id Int?
  changed_by      Int?
  old_data        Json?
  new_data        Json?
  action          String?
  remarks         String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  applied_forms   applied_forms? @relation(fields: [applied_form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model form_forwards {
  id            Int        @id @default(autoincrement())
  form_id       Int
  forwarded_by  Int
  forwarded_to  Int
  note          String?
  action        String?       @default("forwarded")
  remarks       String?
  forwarded_at  DateTime      @default(now()) @db.Timestamp(6)
  applied_forms applied_forms @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from_user     users         @relation("ForwardFrom", fields: [forwarded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_user       users         @relation("ForwardTo", fields: [forwarded_to], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([form_id], map: "idx_forwards_form")
}

model form_approvals {
  id             Int    @id @default(autoincrement())
  form_id        Int?
  approver_id    Int?
  approval_level Int?      @map("stage")
  status         String?   @map("decision")
  comments       String?   @map("approval_data")
  approved_at    DateTime? @default(now()) @map("decided_at") @db.Timestamp(6)
  users          users?    @relation(fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forms          forms?    @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model form_status_history {
  id         Int    @id @default(autoincrement())
  form_id    Int?
  changed_by Int?
  old_status String?
  new_status String?
  changed_at DateTime? @default(now()) @db.Timestamp(6)
  comments   String?
  users      users?    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forms      forms?    @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model forms {
  id                     Int                @id @default(autoincrement())
  form_type_id           Int?
  applicant_id           Int?               @map("submitted_by")
  form_data              Json
  status                 String?               @default("pending") @map("current_status")
  current_approval_level Int?                  @default(1)
  submitted_at           DateTime?             @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @default(now()) @db.Timestamp(6)
  form_approvals         form_approvals[]
  form_status_history    form_status_history[]
  users                  users?                @relation(fields: [applicant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_types             form_types?           @relation(fields: [form_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model permissions {
  id               Int             @id @default(autoincrement())
  name             String             @unique
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model workflows {
  id          Int       @id @default(autoincrement())
  name        String       @unique
  description String?
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  form_types  form_types[]
}
