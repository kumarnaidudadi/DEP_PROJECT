generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model roles {
  id              BigInt       @id @default(autoincrement())
  name            String       @unique
  hierarchy_level Int
  created_at      DateTime?    @default(now()) @db.Timestamp(6)
  user_roles      user_roles[]
}

model user_roles {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt?
  role_id    BigInt?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  roles      roles?    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id])
}

model users {
  id               BigInt             @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  department_id    BigInt?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  applied_forms    applied_forms[]
  department_heads department_heads[]
  form_history     form_history[]
  form_types       form_types[]
  office_orders    office_orders[]
  user_roles       user_roles[]
  forwards_sent    form_forwards[]    @relation("ForwardFrom")
  forwards_received form_forwards[]   @relation("ForwardTo")
}

model department_heads {
  id            BigInt       @id @default(autoincrement())
  department_id BigInt?
  user_id       BigInt?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([department_id, user_id])
}

model departments {
  id               BigInt             @id @default(autoincrement())
  name             String             @unique
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  department_heads department_heads[]
}

model form_types {
  id             BigInt          @id @default(autoincrement())
  name           String
  description    String?
  schema         Json
  created_by     BigInt?
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  approval_rules Json?           @default("{}")  // e.g. { "required_roles": ["HOD", "REGISTRAR"] }
  is_active      Boolean         @default(true)
  applied_forms  applied_forms[]
  users          users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model office_orders {
  id              BigInt         @id @default(autoincrement())
  applied_form_id BigInt?
  order_number    String?
  generated_by    BigInt?
  generated_at    DateTime?      @default(now()) @db.Timestamp(6)
  document_url    String?
  applied_forms   applied_forms? @relation(fields: [applied_form_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model applied_forms {
  id                     BigInt          @id @default(autoincrement())
  form_type_id           BigInt?
  applicant_id           BigInt?
  form_data              Json
  status                 String?         @default("pending")
  current_approval_level Int?            @default(1)
  submitted_at           DateTime?       @default(now()) @db.Timestamp(6)
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  users                  users?          @relation(fields: [applicant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_types             form_types?     @relation(fields: [form_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_history           form_history[]
  form_forwards          form_forwards[]
  office_orders          office_orders[]
}

model form_history {
  id              BigInt         @id @default(autoincrement())
  applied_form_id BigInt?
  changed_by      BigInt?
  old_data        Json?
  new_data        Json?
  action          String?
  remarks         String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  applied_forms   applied_forms? @relation(fields: [applied_form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── DYNAMIC FORWARDING ─────────────────────────────────────────────

model form_forwards {
  id             BigInt        @id @default(autoincrement())
  form_id        BigInt
  forwarded_by   BigInt
  forwarded_to   BigInt
  note           String?
  action         String?       @default("forwarded") // forwarded | approved | rejected
  remarks        String?
  forwarded_at   DateTime      @default(now()) @db.Timestamp(6)
  applied_forms  applied_forms @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from_user      users         @relation("ForwardFrom", fields: [forwarded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_user        users         @relation("ForwardTo", fields: [forwarded_to], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([form_id], map: "idx_forwards_form")
}
